# ==============================================================================
# IDEAERA — PRODUCTION & LOCAL ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# IMPORTANT:
# - Do NOT wrap values in quotes ("" or '').
# - For Vercel deployments, configure these in:
#   Project Settings -> Environment Variables -> Production & Preview.
# ==============================================================================

# Supabase Public API Configuration (REQUIRED on Vercel & Local)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Supabase Database Direct Connection URL (REQUIRED for scripts/migrations)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Pooler)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Production Site URL (Optional, defaults to request origin or https://ideaera.vercel.app)
NEXT_PUBLIC_SITE_URL=https://ideaera.vercel.app
